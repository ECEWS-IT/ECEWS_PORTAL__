<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EcewsPortal</RootNamespace>
    <AssemblyName>EcewsPortal</AssemblyName>
    <Version>1.2.4</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.17.2" />
    <PackageReference Include="Microsoft.Graph" Version="5.77.0" />
    <PackageReference Include="Microsoft.Identity.Web" Version="4.13.1" />
    <PackageReference Include="Microsoft.Identity.Web.UI" Version="4.13.1" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="App_Data\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
